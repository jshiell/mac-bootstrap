#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=steps/common
source "$(dirname "$0")/common"

DOTFILES_REPO="https://github.com/jshiell/dotfiles"
DOTFILES_BRANCH="main"
DOTFILES_DIR="$HOME/dotfiles"

if [[ -d "$DOTFILES_DIR" ]]; then
    echo "Updating $DOTFILES_DIR"
    run git -C "$DOTFILES_DIR" pull --rebase --autostash origin "$DOTFILES_BRANCH" \
        || warn "could not update $DOTFILES_DIR - linking whatever is already there"
else
    echo "Cloning $DOTFILES_REPO into $DOTFILES_DIR"
    run git clone --recursive --branch "$DOTFILES_BRANCH" "$DOTFILES_REPO" "$DOTFILES_DIR"
fi

run git -C "$DOTFILES_DIR" submodule update --init --recursive \
    || warn "could not update the submodules of $DOTFILES_DIR"

# Only reachable under DRY_RUN, where the clone above was echoed rather than run
# and there is no Makefile to hand off to.
if [[ ! -d "$DOTFILES_DIR" ]]; then
    echo "DRY RUN: would run 'make install' in $DOTFILES_DIR"
    exit 0
fi

# The dotfiles repo knows which files it owns and where they go, so let its own
# Makefile place them rather than keeping a second copy of that list here. Its
# targets are the symlinks themselves, so it only acts on the missing ones, and
# -n turns that into the dry run.
make ${DRY_RUN:+-n} -C "$DOTFILES_DIR" install

# install skips a destination that already exists as a real file or directory,
# silently - it has no way to know whether that is yours. status names them.
make -C "$DOTFILES_DIR" status
